APP_NAME=SupportNova
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+psycopg://supportnova:supportnova@localhost:5432/supportnova
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Pipeline 1 — GenAI (never commit real keys)
GENAI_PROVIDER=openai
GENAI_FALLBACK_PROVIDERS=grok,cursor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4-fast
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com/v1
CURSOR_MODEL=composer-2.5
GENAI_MAX_RETRIES=3
GENAI_TIMEOUT_SECONDS=18

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads

# Bootstrap admin (used only on first seed)
BOOTSTRAP_ADMIN_EMAIL=admin@nimbuscarta.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!23
