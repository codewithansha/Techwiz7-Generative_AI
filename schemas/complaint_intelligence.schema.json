{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportNovaComplaintIntelligence",
  "type": "object",
  "required": [
    "complaint_id",
    "primary_issue",
    "issue_category",
    "subcategory",
    "sentiment",
    "urgency",
    "priority",
    "department",
    "resolution_steps",
    "escalation_required",
    "customer_response"
  ],
  "properties": {
    "complaint_id": { "type": "string" },
    "primary_issue": { "type": "string" },
    "secondary_issues": { "type": "array", "items": { "type": "string" } },
    "issue_category": { "type": "string" },
    "subcategory": { "type": "string" },
    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative", "strongly_negative"] },
    "emotion_indicators": { "type": "array", "items": { "type": "string" } },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "department": { "type": "string" },
    "supporting_departments": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "object" },
    "policy_id": { "type": "string" },
    "policy_section": { "type": "string" },
    "policy_applicability": { "type": "string" },
    "resolution_steps": { "type": "array", "items": { "type": "string" } },
    "escalation_required": { "type": "boolean" },
    "escalation_level": { "type": "string" },
    "escalation_reason": { "type": "string" },
    "escalation_notes": { "type": "string" },
    "response_type": { "type": "string" },
    "customer_response": { "type": "string" },
    "follow_up_required": { "type": "boolean" },
    "follow_up_communication": { "type": "string" },
    "clarification_questions": { "type": "array", "items": { "type": "string" } },
    "missing_information": { "type": "array", "items": { "type": "string" } },
    "complaint_summary": { "type": "string" },
    "agent_guidance": { "type": "array", "items": { "type": "string" } },
    "refund_eligible": { "type": ["boolean", "null"] },
    "replacement_eligible": { "type": ["boolean", "null"] },
    "compensation_recommended": { "type": "boolean" }
  },
  "additionalProperties": true
}
